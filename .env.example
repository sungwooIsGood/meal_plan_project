# docker-compose.yml 에서 사용하는 값. 복사해서 .env 로 쓰고 실제 값을 채운다.
#   cp .env.example .env
# .env 는 .gitignore 로 커밋 제외된다.

# 프론트(Vercel) 도메인. 콤마로 여러 개 지정 가능.
# 예) https://meal-plan-project-4956.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OpenAI 분류기 (선택). 안 쓰면 그대로 두면 규칙 기반으로 동작.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
